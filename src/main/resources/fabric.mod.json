  "authors": [
    "infectedwarelol"
  ],
  "contributors": [
    "infectedwarelol",
    "VerseFall-Development",
    "LIMTDD",
    "PoppedByKid",
    "OkaySleepyX"
  ],
  "contact": {
    "homepage": "https://github.com/infectedwarelol/skysong",
    "sources": "https://github.com/infectedwarelol/skysong",
    "issues": "https://github.com/infectedwarelol/skysong/issues"
  },
  "license": "MIT",
  "icon": "assets/skysong/icon.png",
  "environment": "*",
  "accessWidener": "skysong.accesswidener",
  "entrypoints": {
    "main": [
      "dev.infectedware.skysong.SkysongCommon"
    ],
    "client": [
      "dev.infectedware.skysong.SkysongClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
